# Copy to .env next to docker-compose.yml. Keep SECRET_KEY and DB_PASSWORD; they must be the same at every start.

# First administrator, created at start while the database has no users (optional: otherwise a setup page is shown).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-8-chars

# Encrypts stored mail passwords and tokens. Generate with: openssl rand -hex 32
SECRET_KEY=
# Password for the MariaDB user. Generate with: openssl rand -hex 24
DB_PASSWORD=

# The address users reach the app at (behind your reverse proxy). Needed for Google sign-in.
PUBLIC_URL=http://localhost:8080

# Shown on /privacy.html and /terms.html.
OPERATOR_NAME=the operator of this service
OPERATOR_CONTACT=

# Optional: Google sign-in for Gmail (OAuth client of type "Web application"), see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: extra OpenAI-compatible AI services for sorting, e.g. Ollama=http://ollama:11434/v1
AI_EXTRA_PROVIDERS=

# Optional: push notifications for the Android app (Firebase service-account key mounted into the container).
FCM_SERVICE_ACCOUNT_FILE=

# Time zone for dates in backup file names, e.g. Europe/Stockholm
TZ=UTC
